{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.ts", "tools/*.ts"],
  "project": ["src/**/*.ts", "tools/**/*.ts", "contexts/*/src/**/*.ts", "contexts/*/contract/**/*.ts"],
  "bun": false,
  "github-actions": false,
  "node": false,
  "taskfile": false,
  "typescript": false,
  "rules": {
    "files": "warn",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "enumMembers": "off",
    "dependencies": "off",
    "unlisted": "off",
    "unresolved": "off"
  }
}
