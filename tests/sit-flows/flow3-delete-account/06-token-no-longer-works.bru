meta {
  name: C's habits are gone
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/Habit/{{subC}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenC}}
}

assert {
  res.status: eq 200
}

tests {
  test("C has no habits left", function () {
    expect(res.body.length).to.equal(0);
  });
}
