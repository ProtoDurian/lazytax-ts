meta {
  name: complete
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/Habit/{{subB}}/{{checkVersionId}}/executions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenB}}
}

body:json {
  {"notes":"SIT"}
}

assert {
  res.status: eq 200
}

tests {
  test("succeeded", function () {
    expect(res.body.status).to.equal("succeeded");
    expect(res.body.habitVersionId).to.equal(bru.getVar("checkVersionId"));
  });
}
