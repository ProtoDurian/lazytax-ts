meta {
  name: list-executions
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/Habit/{{subB}}/executions?id={{checkHabitId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenB}}
}

assert {
  res.status: eq 200
}

tests {
  test("one execution", function () {
    expect(res.body.length).to.equal(1);
  });
}
