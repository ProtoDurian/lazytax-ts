meta {
  name: A has no consent yet
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/Payment/{{subA}}/consent
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenA}}
}

assert {
  res.status: eq 200
}

tests {
  test("not linked", function () {
    expect(res.body.hasPaymentConsent).to.equal(false);
    expect(res.body.consentId).to.equal(null);
  });
}
