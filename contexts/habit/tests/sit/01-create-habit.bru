meta {
  name: create-habit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/Habit/{{subA}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

body:json {
  {"task":"SIT run","daysOfWeek":["monday","Friday"],"notificationTime":"07:00:00","stake":"0","timezone":"Asia/Singapore"}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("habitId", res.body.habitId); bru.setVar("versionId", res.body.id);
}
