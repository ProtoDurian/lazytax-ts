meta {
  name: resolve the tag
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/NfcTag/{{subA}}/sit-tag-{{habitId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

assert {
  res.status: eq 200
}

tests {
  test("habit and today", function () { expect(res.body.tag.habitId).to.equal(bru.getVar("habitId")); expect(res.body.today).to.match(/^\d{4}-\d{2}-\d{2}$/); });
}
