meta {
  name: mint a token for sit-vacation-v
  type: http
  seq: 1
}

post {
  url: {{logtoUrl}}/token
  body: json
  auth: none
}

body:json {
  {"sub":"sit-vacation-v","scope":""}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("tokenV", res.body.access_token);
  bru.setVar("subV", "sit-vacation-v");
}
