meta {
  name: free plan has no windows 400
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/Vacation/{{subV}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenV}}
}

body:json {
  {"startDate":"2099-07-01","endDate":"2099-07-05","timezone":"UTC"}
}

assert {
  res.status: eq 400
  res.body.type: eq urn:lazytax:problem:tier_insufficient
}
