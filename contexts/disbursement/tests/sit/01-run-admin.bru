meta {
  name: run as admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/disbursement/run
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenAdmin}}
}

assert {
  res.status: eq 200
}

tests {
  test("body has completed count", function () {
    expect(res.body.completed).to.be.a("number");
  });
}

