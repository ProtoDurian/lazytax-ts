meta {
  name: mint a token for sit-account-d
  type: http
  seq: 1
}

post {
  url: {{logtoUrl}}/token
  body: json
  auth: none
}

body:json {
  {"sub":"sit-account-d","scope":""}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("tokenD", res.body.access_token);
  bru.setVar("subD", "sit-account-d");
}
